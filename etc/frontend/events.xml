<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="checkout_cart_product_add_before">
        <observer name="commercepundit_paymenttransactionfailed_cart_product_add_before"
                  instance="Commercepundit\PaymentTransactionFailed\Observer\CartProductAddBeforeObserver"/>
    </event>
    <event name="controller_action_predispatch">
        <observer name="commercepundit_paymenttransactionfailed_track_browse"
                  instance="Commercepundit\PaymentTransactionFailed\Observer\TrackBrowseObserver"/>
    </event>
</config>
